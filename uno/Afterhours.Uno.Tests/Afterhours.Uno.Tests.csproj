  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The app targets browser WebAssembly only, so its platform-free service files are compiled here directly. -->
  <ItemGroup>
    <Compile Include="../Afterhours.Uno/Services/GameRecords.cs;../Afterhours.Uno/Services/BridgeJsonContext.cs;../Afterhours.Uno/Services/Latest.cs;../Afterhours.Uno/Services/GameEvents.cs;../Afterhours.Uno/Services/ShopRecords.cs;../Afterhours.Uno/Services/EventStream.cs;../Afterhours.Uno/Presentation/ShopViews.cs" Link="App/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
