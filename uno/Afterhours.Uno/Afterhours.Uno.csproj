<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <!-- Required by the JSImport/JSExport source generator. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A member Uno has not implemented silently does nothing at runtime; fail the build instead. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <UnoSingleProject>true</UnoSingleProject>
    <!-- Browser targets use NuGet/runtime packs and do not need Windows SDK registry discovery. -->
    <TargetPlatformSdkPath>$(MSBuildSDKsPath)</TargetPlatformSdkPath>
    <TargetPlatformDisplayName>Browser WebAssembly</TargetPlatformDisplayName>

    <!-- Display name -->
    <ApplicationTitle>Afterhours</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.afterhours-uno</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Afterhours.Uno</ApplicationPublisher>
    <!-- Package Description -->
    <Description>A social music world. Make a track, build a room, find your people. Built with Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Hosting;
      Toolkit;
      MVUX;
      Navigation;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
</Project>
