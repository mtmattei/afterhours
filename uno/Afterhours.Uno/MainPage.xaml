<Page x:Class="Afterhours.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:interop="using:Afterhours.Uno.Interop"
      Background="#14141B">
  <!-- WAVE 0 SPIKE: XAML controls above the hosted game room. Replaced in wave 1. -->
  <Grid Background="#14141B">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel x:Name="SpikeBar" Orientation="Horizontal" Spacing="12" Padding="16,10" Background="#1C1C25">
      <TextBlock x:Name="SpikeTitle" Text="afterhours xaml" FontFamily="ms-appx:///Assets/Fonts/DMSans_Regular.ttf#DM Sans"
                 FontSize="18" CharacterSpacing="150" Foreground="#DFED8C" VerticalAlignment="Center" />
      <TextBlock x:Name="CoinsText" Text="✦ —" Foreground="#F3F1E9" VerticalAlignment="Center" AutomationProperties.AutomationId="CoinsText" />
      <Button x:Name="GiftButton" Content="Daily gift" Click="Gift_Click" AutomationProperties.AutomationId="GiftButton" />
      <Button x:Name="PlayButton" Content="Play beat" Click="Play_Click" AutomationProperties.AutomationId="PlayButton" />
      <TextBox x:Name="SpikeInput" PlaceholderText="Type here" Width="180" AutomationProperties.AutomationId="SpikeInput" />
      <Button x:Name="PanelButton" Content="Open panel" AutomationProperties.AutomationId="PanelButton">
        <Button.Flyout>
          <Flyout x:Name="SpikeFlyout" Placement="Bottom" Closed="Flyout_Closed">
            <Grid Width="420" Height="520">
              <StackPanel Spacing="12">
                <TextBlock Text="A XAML panel over the room" FontSize="18" Foreground="#F3F1E9" />
                <TextBlock Text="If this sits on top of the canvas and the button works, the overlay holds." TextWrapping="Wrap" Foreground="#92929F" />
              </StackPanel>
              <Button x:Name="FlyoutAction" Content="Count a click" VerticalAlignment="Bottom" Click="FlyoutAction_Click" AutomationProperties.AutomationId="FlyoutAction" />
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock x:Name="SpikeStatus" Foreground="#92929F" VerticalAlignment="Center" AutomationProperties.AutomationId="SpikeStatus" />
    </StackPanel>
    <interop:RoomHost x:Name="Room" Grid.Row="1" />
    <Grid x:Name="LoadingPanel" Grid.RowSpan="2" Background="#14141B">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="420" Margin="32">
        <TextBlock Text="afterhours ✳" FontSize="44" FontWeight="Bold" Foreground="#DFED8C" HorizontalAlignment="Center"/>
        <TextBlock x:Name="LoadingMessage" Text="Opening your world…" FontSize="15" Foreground="#C4BDCE" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        <ProgressBar x:Name="LoadingRing" IsIndeterminate="True" Width="120" Height="3" Foreground="#DFED8C"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
