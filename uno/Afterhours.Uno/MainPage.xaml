<Page x:Class="Afterhours.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Afterhours.Uno"
      Background="#14141B">
  <Grid Background="#14141B">
    <WebView2 x:Name="GameView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    <Grid x:Name="LoadingPanel" Background="#14141B">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="420" Margin="32">
        <TextBlock Text="afterhours ✳" FontSize="44" FontWeight="Bold" Foreground="#DFED8C" HorizontalAlignment="Center"/>
        <TextBlock x:Name="LoadingMessage" Text="Opening your world…" FontSize="15" Foreground="#C4BDCE" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
        <ProgressBar x:Name="LoadingRing" IsIndeterminate="True" Width="120" Height="3" Foreground="#DFED8C"/>
        <Button x:Name="RetryButton" Content="Try again" Click="Retry_Click" Visibility="Collapsed" HorizontalAlignment="Center"/>
        <TextBlock Text="BUILT WITH UNO PLATFORM · WEBASSEMBLY" FontSize="10" CharacterSpacing="150" Foreground="#777380" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
