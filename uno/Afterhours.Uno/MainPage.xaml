<Page x:Class="Afterhours.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:interop="using:Afterhours.Uno.Interop"
      xmlns:views="using:Afterhours.Uno.Views"
      xmlns:conv="using:Afterhours.Uno.Converters"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      x:Name="Root"
      Background="{StaticResource SurfaceBaseBrush}">
  <!-- The app's chrome around the JavaScript room. Buttons pass a host.mjs command name to Run;
       Afterhours.Uno.Tests checks every name against that allowlist. -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
    <conv:BoolToOpacityConverter x:Key="SolidWhen" />
    <conv:BoolToOpacityConverter x:Key="FadedWhen" Invert="True" />
    <conv:DataUrlImageConverter x:Key="DataUrlImage" />
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Grid Padding="{utu:Responsive Narrowest='12,10', Narrow='24,12'}" ColumnSpacing="12"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="afterhours" Style="{StaticResource BrandText}" />
        <TextBlock Text="✳" Style="{StaticResource BrandText}" Foreground="{StaticResource AcidBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="shared"
                Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}" AutomationProperties.Name="Shared world">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{StaticResource AcidBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Chrome.Connection.Label}" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="Furniture shop" Style="{StaticResource SoftButtonStyle}" Command="{Binding OpenShop}"
                Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" AutomationProperties.Name="Credits">
          <TextBlock Text="✦" Style="{StaticResource NumeralText}" Foreground="{StaticResource AcidBrush}" />
          <TextBlock Text="{Binding Hud.Coins}" Style="{StaticResource NumeralText}" />
        </StackPanel>
        <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="profile" Padding="4"
                AutomationProperties.Name="Your profile">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="36" CornerRadius="7" Background="{StaticResource SurfaceRaisedBrush}">
              <Image Source="{Binding Portrait.Png, Converter={StaticResource DataUrlImage}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel VerticalAlignment="Center" Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}">
              <TextBlock Text="{Binding Hud.Name}" Style="{StaticResource BodyStrongText}" />
              <TextBlock Text="{Binding Hud.LevelLabel}" Style="{StaticResource EyebrowText}" />
            </StackPanel>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Rail: labels from Wide, icons only from Narrow, hidden below (the bottom bar takes over). -->
      <ScrollViewer Width="{utu:Responsive Narrow=72, Wide=220}" Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Padding="{utu:Responsive Narrow='6,16', Wide='12,16'}" Spacing="4">
          <TextBlock Text="YOUR WORLD" Style="{StaticResource EyebrowText}" Margin="12,0,0,8"
                     Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="rooms"
                  AutomationProperties.Name="Explore rooms" ToolTipService.ToolTip="Explore rooms">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <!-- A bar marks where you are: public rooms here, your room below (shape cue, not colour alone). -->
              <Rectangle Width="3" Height="18" Fill="{StaticResource AcidBrush}"
                         Opacity="{Binding Chrome.Room.Personal, Converter={StaticResource FadedWhen}}" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE774;" />
              <TextBlock Text="Explore" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="home"
                  AutomationProperties.Name="My room" ToolTipService.ToolTip="My room">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" Height="18" Fill="{StaticResource AcidBrush}"
                         Opacity="{Binding Chrome.Room.Personal, Converter={StaticResource SolidWhen}}" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE80F;" />
              <TextBlock Text="My room" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="studio"
                  AutomationProperties.Name="Beat studio" ToolTipService.ToolTip="Beat studio">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE8D6;" />
              <TextBlock Text="Beat studio" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="look"
                  AutomationProperties.Name="My look" ToolTipService.ToolTip="My look">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE77B;" />
              <TextBlock Text="My look" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="journal"
                  AutomationProperties.Name="Journal" ToolTipService.ToolTip="Journal">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE8F1;" />
              <TextBlock Text="Journal" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
              <Border Background="{StaticResource AcidBrush}" CornerRadius="8" Padding="6,0"
                      Visibility="{Binding Hud.HasQuestsReady, Converter={StaticResource ShownWhen}}">
                <TextBlock Text="{Binding Hud.QuestsReady}" Style="{StaticResource CaptionText}" Foreground="{StaticResource OnAcidBrush}" />
              </Border>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="arcade"
                  AutomationProperties.Name="Arcade" ToolTipService.ToolTip="Arcade">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE7FC;" />
              <TextBlock Text="Arcade" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>

          <Grid Margin="12,20,0,4" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}">
            <TextBlock Text="ROOM HOPPING" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
          </Grid>
          <ListView ItemsSource="{Binding RoomStops}" SelectionMode="None" IsItemClickEnabled="True"
                    utu:CommandExtensions.Command="{Binding Travel}" AutomationProperties.Name="Public rooms">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="10" Padding="0,6" AutomationProperties.Name="{Binding Room.Title}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                    <TextBlock Text="{Binding Room.Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
                  </Border>
                  <!-- Marks the room you are in (shape cue, not colour alone). -->
                  <Rectangle Width="3" Height="18" Margin="-8,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource AcidBrush}"
                             Visibility="{Binding Current, Converter={StaticResource ShownWhen}}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{utu:Responsive Layout={StaticResource DefaultResponsiveLayout}, Narrow=Collapsed, Wide=Visible}">
                    <TextBlock Text="{Binding Room.Title}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{Binding Room.Detail}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <Button Content="All rooms ↗" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="rooms"
                  Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />

          <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,16,0,0" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}">
            <StackPanel Spacing="8">
              <Grid>
                <TextBlock Text="{Binding Hud.LevelLabel}" Style="{StaticResource BodyStrongText}" />
                <TextBlock Text="{Binding Hud.XpLabel}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
              </Grid>
              <ProgressBar Value="{Binding Hud.XpProgress}" Maximum="1" Foreground="{StaticResource AcidBrush}"
                           AutomationProperties.Name="Progress to the next level" />
              <TextBlock Text="{Binding Hud.NextQuest}" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Hud.NextQuestDetail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
              <Button Content="{Binding Hud.DailyLabel}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                      Command="{Binding Run}" CommandParameter="daily" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="help" Margin="0,12,0,0"
                  AutomationProperties.Name="How to play" ToolTipService.ToolTip="How to play">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Rectangle Width="3" />
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xE897;" />
              <TextBlock Text="New around here?" Style="{StaticResource BodyText}" Visibility="{utu:Responsive Narrow=Collapsed, Wide=Visible}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>

      <!-- Stage: heading, the JavaScript room, the editor bar, actions and now playing. -->
      <Grid Grid.Column="1" Padding="{utu:Responsive Narrowest='12,12', Narrow='24,16'}" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Chrome.Room.Eyebrow}" Style="{StaticResource EyebrowText}" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Chrome.Room.DisplayTitle}" Style="{StaticResource DisplayText}" />
              <TextBlock Text="." Style="{StaticResource DisplayText}" Foreground="{StaticResource AcidBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding Chrome.Room.Meta}" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center"
                  Command="{Binding Run}" CommandParameter="favorite" AutomationProperties.Name="Save this room to favourites">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Style="{StaticResource IconText}" Glyph="&#xEB51;" />
              <TextBlock Text="{Binding Chrome.Room.SaveLabel}" Style="{StaticResource BodyText}" />
            </StackPanel>
          </Button>
        </Grid>

        <Grid Grid.Row="1">
          <Border CornerRadius="{StaticResource CardRadius}" Background="{StaticResource SurfacePanelBrush}">
            <interop:RoomHost x:Name="Room" />
          </Border>
          <Border Style="{StaticResource SurfaceCardStyle}" VerticalAlignment="Bottom" Margin="12"
                  Visibility="{Binding Chrome.Editor.Active, Converter={StaticResource ShownWhen}}">
            <Grid ColumnSpacing="12" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Chrome.Editor.Title}" Style="{StaticResource BodyStrongText}" />
                <TextBlock Text="{Binding Chrome.Editor.Hint}" Style="{StaticResource CaptionText}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Rotate" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="rotate"
                        IsEnabled="{Binding Chrome.Editor.CanRotate}" />
                <Button Content="Put away" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="store"
                        IsEnabled="{Binding Chrome.Editor.CanStore}" />
                <Button Content="Undo" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="undo"
                        IsEnabled="{Binding Chrome.Editor.CanUndo}" />
                <Button Content="＋ Furniture" Style="{StaticResource SoftButtonStyle}" Command="{Binding OpenInventory}" />
                <Button Content="Done" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Run}" CommandParameter="finish" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="✋ Wave" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="wave" />
            <Button Content="{Binding Chrome.Actions.DanceLabel}" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="dance" />
            <Button Content="Stand up" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="stand"
                    Visibility="{Binding Chrome.Actions.Seated, Converter={StaticResource ShownWhen}}" />
            <Button Content="Decorate" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="decorate" />
            <Rectangle Width="1" Margin="6,8" Fill="{StaticResource LineBrush}" />
            <Button Content="Stage" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="stage" />
            <Button Content="Catalog" Style="{StaticResource SoftButtonStyle}" Command="{Binding OpenShop}" />
            <Button Content="My rooms" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="myRooms" />
            <Button Content="Companion" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="companion" />
            <Button Content="Room tools" Style="{StaticResource SoftButtonStyle}" Command="{Binding Run}" CommandParameter="roomTools" />
            <Button Content="Chat" Style="{StaticResource SoftButtonStyle}" Visibility="{utu:Responsive Normal=Visible, Wide=Collapsed}">
              <Button.Flyout>
                <Flyout Placement="Top">
                  <views:ChatPanel Width="340" Height="460" />
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Padding="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource PrimaryButtonStyle}" Width="40" Height="40" Padding="0" CornerRadius="20"
                    Command="{Binding Run}" CommandParameter="play" AutomationProperties.Name="{Binding Chrome.NowPlaying.PlayLabel}">
              <TextBlock Text="{Binding Chrome.NowPlaying.PlayGlyph}" Style="{StaticResource BodyStrongText}" Foreground="{StaticResource OnAcidBrush}" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <Grid>
                <TextBlock Text="{Binding Chrome.NowPlaying.Title}" Style="{StaticResource BodyStrongText}" />
                <TextBlock Text="{Binding Chrome.NowPlaying.Time}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
              </Grid>
              <TextBlock Text="{Binding Chrome.NowPlaying.Subtitle}" Style="{StaticResource CaptionText}" />
              <ProgressBar Value="{Binding Chrome.NowPlaying.Progress}" Maximum="100" Foreground="{StaticResource AcidBrush}"
                           AutomationProperties.Name="Track progress" />
            </StackPanel>
            <Button Grid.Column="2" Content="Make a beat ↗" Style="{StaticResource SoftButtonStyle}" VerticalAlignment="Center"
                    Command="{Binding Run}" CommandParameter="studio" Visibility="{utu:Responsive Narrowest=Collapsed, Narrow=Visible}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Chat column on wide windows. -->
      <Border Grid.Column="2" Width="{StaticResource ChatColumnWidth}" Background="{StaticResource SurfacePanelBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
              Visibility="{utu:Responsive Normal=Collapsed, Wide=Visible}">
        <views:ChatPanel />
      </Border>
    </Grid>

    <!-- Bottom bar on phones. -->
    <Grid Grid.Row="2" Padding="8" ColumnSpacing="4" Background="{StaticResource SurfacePanelBrush}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
          Visibility="{utu:Responsive Narrowest=Visible, Narrow=Collapsed}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" Command="{Binding Run}" CommandParameter="rooms" AutomationProperties.Name="Explore rooms">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE774;" />
      </Button>
      <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" Command="{Binding Run}" CommandParameter="home" AutomationProperties.Name="My room">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE80F;" />
      </Button>
      <Button Grid.Column="2" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" Command="{Binding Run}" CommandParameter="studio" AutomationProperties.Name="Beat studio">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE8D6;" />
      </Button>
      <Button Grid.Column="3" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" AutomationProperties.Name="Room chat">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE8BD;" />
        <Button.Flyout>
          <Flyout Placement="Top">
            <views:ChatPanel Width="320" Height="440" />
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Grid.Column="4" Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Center" AutomationProperties.Name="More">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE712;" />
        <Button.Flyout>
          <Flyout Placement="Top">
            <StackPanel Spacing="4" MinWidth="200">
              <Button Content="My look" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="look" />
              <Button Content="Journal" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="journal" />
              <Button Content="Arcade" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="arcade" />
              <Button Content="Furniture shop" Style="{StaticResource QuietButtonStyle}" Command="{Binding OpenShop}" />
              <Button Content="{Binding Hud.DailyLabel}" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="daily" />
              <Button Content="{Binding Chrome.Connection.Label}" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="shared" />
              <Button Content="How to play" Style="{StaticResource QuietButtonStyle}" Command="{Binding Run}" CommandParameter="help" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Covers the page until the game reports ready; offers a reload if it cannot open. -->
    <mvux:FeedView x:Name="Boot" Grid.RowSpan="3" Source="{Binding Status}"
                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <Grid />
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <Grid Background="{StaticResource SurfaceBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="420" Margin="32">
              <TextBlock Text="afterhours ✳" Style="{StaticResource BrandText}" HorizontalAlignment="Center" Foreground="{StaticResource AcidBrush}" />
              <TextBlock Text="Opening your world…" Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
              <ProgressBar IsIndeterminate="True" Width="120" Foreground="{StaticResource AcidBrush}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>
      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <Grid Background="{StaticResource SurfaceBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="420" Margin="32">
              <TextBlock Text="afterhours ✳" Style="{StaticResource BrandText}" HorizontalAlignment="Center" Foreground="{StaticResource AcidBrush}" />
              <TextBlock Text="Your world could not open. Check your connection and try again." Style="{StaticResource BodyText}"
                         TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" />
              <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
              <Button Content="Try again" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                      Command="{Binding DataContext.Retry, ElementName=Root}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
