<Page x:Class="Afterhours.Uno.Presentation.SpikePanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1C1C25">
  <!-- WAVE 0 SPIKE -->
  <Grid Width="420" Height="560" Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="A route panel over the room" FontSize="18" Foreground="#F3F1E9" />
      <TextBlock Text="{Binding Clicks}" Foreground="#DFED8C" />
    </StackPanel>
    <Button Content="Count with MVUX" VerticalAlignment="Bottom" Command="{Binding Count}" />
  </Grid>
</Page>
