<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Values from dist/style.css :root and the chrome rules. The app is dark only (color-scheme: dark),
       so these are StaticResource values; Fluent's own keys are overridden in Controls.xaml. -->
  <Color x:Key="SurfaceBaseColor">#14141B</Color>
  <Color x:Key="SurfacePanelColor">#1C1C25</Color>
  <Color x:Key="SurfaceRaisedColor">#24242E</Color>
  <Color x:Key="SurfaceHoverColor">#2C2C38</Color>
  <Color x:Key="SurfaceAccentTintColor">#22DDEB8D</Color>
  <Color x:Key="LineColor">#14FFFFFF</Color>
  <Color x:Key="InkColor">#F3F1E9</Color>
  <Color x:Key="InkSoftColor">#C4BDCE</Color>
  <Color x:Key="MutedColor">#92929F</Color>
  <Color x:Key="AcidColor">#DFED8C</Color>
  <Color x:Key="AcidHoverColor">#E9F4AE</Color>
  <Color x:Key="AcidPressedColor">#C8D57A</Color>
  <Color x:Key="OnAcidColor">#303522</Color>

  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="SurfaceAccentTintBrush" Color="{StaticResource SurfaceAccentTintColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AcidBrush" Color="{StaticResource AcidColor}" />
  <SolidColorBrush x:Key="OnAcidBrush" Color="{StaticResource OnAcidColor}" />
  <!-- Dims the room behind an open panel drawer. -->
  <SolidColorBrush x:Key="DrawerScrimBrush" Color="#99000000" />

  <FontFamily x:Key="BodyFontFamily">ms-appx:///Assets/Fonts/DMSans_Regular.ttf#DM Sans</FontFamily>
  <FontFamily x:Key="BodyStrongFontFamily">ms-appx:///Assets/Fonts/DMSans_Bold.ttf#DM Sans</FontFamily>
  <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/BarlowCondensed_ExtraBold.ttf#Barlow Condensed ExtraBold</FontFamily>
  <FontFamily x:Key="BrandFontFamily">ms-appx:///Assets/Fonts/SpaceGrotesk_Bold.ttf#Space Grotesk</FontFamily>

  <x:Double x:Key="RailWideWidth">220</x:Double>
  <x:Double x:Key="RailCompactWidth">72</x:Double>
  <x:Double x:Key="ChatColumnWidth">300</x:Double>
  <x:Double x:Key="ControlHeight">36</x:Double>

  <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
  <Thickness x:Key="PanelPadding">16</Thickness>
  <Thickness x:Key="ChipPadding">12,0,12,0</Thickness>
  <CornerRadius x:Key="ChipRadius">8</CornerRadius>
  <CornerRadius x:Key="CardRadius">12</CornerRadius>
  <CornerRadius x:Key="FlyoutRadius">16</CornerRadius>
</ResourceDictionary>
