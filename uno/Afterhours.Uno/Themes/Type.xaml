<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The type ramp. Pages use these styles and never set FontSize directly. -->
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontFamily" Value="{StaticResource BodyStrongFontFamily}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="CharacterSpacing" Value="150" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="DisplayText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="BrandText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="CharacterSpacing" Value="-60" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style x:Key="NumeralText" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongText}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="IconText" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
</ResourceDictionary>
