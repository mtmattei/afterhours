<Page x:Class="Afterhours.Uno.Views.BlueprintsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{StaticResource SurfacePanelBrush}" Width="{utu:Responsive Narrowest=340, Narrow=440}">
  <!-- Saved room layouts. Opened with !Blueprints (from Room tools in the game). -->
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="BLUEPRINTS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
    <TextBlock Text="Keep a room in your pocket" Style="{StaticResource TitleText}" />
    <TextBlock Text="A blueprint remembers positions and lighting. Restoring moves your owned pieces back into place."
               Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
    <InfoBar IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />
    <Button Content="Save current layout" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Save}" />
    <mvux:FeedView x:Name="Saved" Source="{Binding Blueprints}" HorizontalContentAlignment="Stretch">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ItemsControl ItemsSource="{Binding Data}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="12" Padding="12" Margin="0,0,0,6" CornerRadius="{StaticResource ChipRadius}"
                      Background="{StaticResource SurfaceRaisedBrush}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                    <TextBlock Text="{Binding Pieces}" Style="{StaticResource CaptionText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Restore" Style="{StaticResource SoftButtonStyle}" CommandParameter="{Binding}"
                          Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.Restore}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <TextBlock Text="No blueprints yet." Style="{StaticResource CaptionText}" />
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>
    </mvux:FeedView>
  </StackPanel>
</Page>
