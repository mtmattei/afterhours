<Page x:Class="Afterhours.Uno.Views.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:conv="using:Afterhours.Uno.Converters"
      Background="{StaticResource SurfacePanelBrush}"
      Width="{utu:Responsive Narrowest=360, Narrow=640, Normal=900}">
  <!-- The furniture shop, your inventory and your records. Opened with !Catalog and a CatalogRequest(tab). -->
  <Page.Resources>
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
    <conv:UrlImageConverter x:Key="AtlasImage" />
    <conv:ArtClipConverter x:Key="ArtClip" />
    <DataTemplate x:Key="CardTemplate">
      <StackPanel Spacing="4" Padding="0,8,0,12" CornerRadius="{StaticResource ChipRadius}" Background="{StaticResource SurfaceRaisedBrush}"
                  AutomationProperties.Name="{Binding Name}">
        <Canvas Width="140" Height="118" HorizontalAlignment="Center" Clip="{Binding Art.ClipRect, Converter={StaticResource ArtClip}}">
          <Image Source="{Binding Art.Url, Converter={StaticResource AtlasImage}}" Stretch="Fill"
                 Width="{Binding Art.Width}" Height="{Binding Art.Height}" Canvas.Left="{Binding Art.Left}" Canvas.Top="{Binding Art.Top}" />
        </Canvas>
        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="THE FURNITURE SHOP" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AcidBrush}" />
      <TextBlock Text="Room for imagination" Style="{StaticResource TitleText}" />
    </StackPanel>

    <!-- Tabs: a bar under the selected one (shape cue, not colour alone). -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="shop">
        <StackPanel Spacing="4">
          <TextBlock Text="Shop furniture" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsShop, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="owned">
        <StackPanel Spacing="4">
          <TextBlock Text="My inventory" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsOwned, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding ShowTab}" CommandParameter="discs">
        <StackPanel Spacing="4">
          <TextBlock Text="Records" Style="{StaticResource BodyStrongText}" />
          <Rectangle Height="2" Fill="{StaticResource AcidBrush}" Visibility="{Binding Tabs.IsDiscs, Converter={StaticResource ShownWhen}}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <InfoBar Grid.Row="2" IsOpen="{Binding HasError}" Severity="Error" IsClosable="False" Message="{Binding Error}" />

    <!-- Furniture (shop and inventory) -->
    <Grid Grid.Row="3" ColumnSpacing="16" Visibility="{Binding Tabs.ShowsFurniture, Converter={StaticResource ShownWhen}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListView Width="200" ItemsSource="{Binding Collections}" SelectionMode="None" IsItemClickEnabled="True"
                utu:CommandExtensions.Command="{Binding ShowCollection}" AutomationProperties.Name="Furniture collections"
                Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnSpacing="8" Padding="0,4" AutomationProperties.Name="{Binding Name}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Rectangle Height="16" Fill="{StaticResource AcidBrush}" Visibility="{Binding Selected, Converter={StaticResource ShownWhen}}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyText}" />
              <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource CaptionText}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <Grid Grid.Column="1" RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Heading.Name}" Style="{StaticResource BodyStrongText}" />
          <TextBlock Text="{Binding Heading.Tagline}" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Find your next favorite piece…"
                   AutomationProperties.Name="Search furniture" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Key"
                    SelectedValue="{Binding Category, Mode=TwoWay}" MinWidth="150" AutomationProperties.Name="Furniture category" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Balance}" Style="{StaticResource CaptionText}" />
        <mvux:FeedView Grid.Row="3" Source="{Binding Cards}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <!-- ItemsRepeater virtualizes: only the cards in view are created (GridView realized all 87 at once). -->
              <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater ItemsSource="{Binding Data}" ItemTemplate="{StaticResource CardTemplate}"
                               utu:CommandExtensions.Command="{Binding Parent.Open}" AutomationProperties.Name="Furniture">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="140" MinItemHeight="176" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ScrollViewer>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <TextBlock Text="Opening the shop…" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>
          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <TextBlock Text="No pieces here yet. Try another collection or search." Style="{StaticResource BodyText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>
          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <TextBlock Text="The shop could not open. Close it and try again." Style="{StaticResource BodyText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
      </Grid>
    </Grid>

    <!-- Records -->
    <StackPanel Grid.Row="3" Spacing="12" Visibility="{Binding Tabs.IsDiscs, Converter={StaticResource ShownWhen}}">
      <TextBlock Text="Your own music, pressed into keepsakes. Each disc costs 10 credits and preserves that version of the song."
                 Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
      <mvux:FeedView Source="{Binding Discs}" HorizontalContentAlignment="Stretch">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <ListView ItemsSource="{Binding Data}" SelectionMode="None" IsItemClickEnabled="True"
                      utu:CommandExtensions.Command="{Binding Parent.PlayDisc}" AutomationProperties.Name="Your records">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{Binding Title}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="◉" Style="{StaticResource TitleText}" Foreground="{StaticResource AcidBrush}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="▶ Play record" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <TextBlock Text="Your record shelf is empty. Save a song in the studio, then press it in your library."
                       Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>
      </mvux:FeedView>
    </StackPanel>

    <!-- One piece in detail (replaces the grid, as in the game). -->
    <Grid Grid.Row="3" Background="{StaticResource SurfacePanelBrush}" RowSpacing="12"
          Visibility="{Binding Selection.IsOpen, Converter={StaticResource ShownWhen}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Canvas Width="320" Height="250" HorizontalAlignment="Left" Clip="{Binding Selection.Card.Preview.ClipRect, Converter={StaticResource ArtClip}}">
        <Image Source="{Binding Selection.Card.Preview.Url, Converter={StaticResource AtlasImage}}" Stretch="Fill"
               Width="{Binding Selection.Card.Preview.Width}" Height="{Binding Selection.Card.Preview.Height}"
               Canvas.Left="{Binding Selection.Card.Preview.Left}" Canvas.Top="{Binding Selection.Card.Preview.Top}" />
      </Canvas>
      <StackPanel Grid.Row="1" Spacing="6" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Selection.Card.Name}" Style="{StaticResource TitleText}" />
        <TextBlock Text="{Binding Selection.Card.Description}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
        <TextBlock Text="{Binding Selection.Card.Facts}" Style="{StaticResource CaptionText}" />
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{Binding Selection.Card.PrimaryLabel}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Primary}" />
        <Button Content="Interact" Style="{StaticResource SoftButtonStyle}" Command="{Binding Interact}"
                Visibility="{Binding Selection.CanInteract, Converter={StaticResource ShownWhen}}" />
        <Button Content="Back to catalog" Style="{StaticResource SoftButtonStyle}" Command="{Binding Back}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
