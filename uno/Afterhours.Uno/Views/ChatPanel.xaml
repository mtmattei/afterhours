<UserControl x:Class="Afterhours.Uno.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             xmlns:conv="using:Afterhours.Uno.Converters">
  <!-- Room chat. Shown as a column on wide windows and inside a flyout on narrower ones;
       it binds to MainViewModel through the inherited DataContext. -->
  <UserControl.Resources>
    <conv:HexBrushConverter x:Key="NameBrush" Fallback="{StaticResource InkSoftBrush}" />
    <conv:BoolToVisibilityConverter x:Key="ShownWhen" />
    <conv:BoolToVisibilityConverter x:Key="HiddenWhen" Invert="True" />
  </UserControl.Resources>
  <Grid RowSpacing="12" Padding="{StaticResource PanelPadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Room chat" Style="{StaticResource BodyStrongText}" />
        <TextBlock Text="{Binding Chrome.Room.Guests}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Content="Friends" Style="{StaticResource QuietButtonStyle}"
              Command="{Binding Run}" CommandParameter="friends" />
      <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Background="Transparent"
              Command="{Binding Run}" CommandParameter="chatPrefs"
              AutomationProperties.Name="Chat preferences" ToolTipService.ToolTip="Chat preferences">
        <FontIcon Style="{StaticResource IconText}" Glyph="&#xE713;" />
      </Button>
    </Grid>

    <ListView x:Name="Lines" Grid.Row="1" ItemsSource="{Binding ChatLines}" SelectionMode="None" IsItemClickEnabled="False"
              AutomationProperties.Name="Room messages" AutomationProperties.LiveSetting="Polite">
      <ListView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel VerticalAlignment="Bottom" />
        </ItemsPanelTemplate>
      </ListView.ItemsPanel>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="0,6">
            <TextBlock Text="{Binding Text}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Visibility="{Binding System, Converter={StaticResource ShownWhen}}" />
            <StackPanel Spacing="2" Visibility="{Binding System, Converter={StaticResource HiddenWhen}}">
              <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,1" Background="{Binding Color, Converter={StaticResource NameBrush}}">
                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" Foreground="{StaticResource InkBrush}" />
              </Border>
              <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Grid Grid.Row="2" RowSpacing="8" ColumnSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ComboBox ItemsSource="{Binding ChatModes}" DisplayMemberPath="Name" SelectedValuePath="Id"
                SelectedValue="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Chat mode" />
      <ComboBox Grid.Column="1" Visibility="{Binding IsWhisper, Converter={StaticResource ShownWhen}}" ItemsSource="{Binding WhisperTargets}" DisplayMemberPath="Name" SelectedValuePath="Id"
                SelectedValue="{Binding WhisperTarget, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Whisper to…"
                AutomationProperties.Name="Whisper to" />
      <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="MessageBox" Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Say hey to the room…"
                 MaxLength="160" AutomationProperties.Name="Room message" utu:CommandExtensions.Command="{Binding Send}" />
        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding Send}"
                CommandParameter="{Binding Text, ElementName=MessageBox}"
                AutomationProperties.Name="Send message">
          <FontIcon Style="{StaticResource IconText}" Glyph="&#xE724;" />
        </Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
