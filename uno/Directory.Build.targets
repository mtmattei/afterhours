<Project>
  <!-- Opt-in task loading compatibility. Identical packaged tasks run in-process. -->
  <PropertyGroup>
    <_AfterhoursUnoTasksAssembly>$(NuGetPackageRoot)/uno.winui/6.7.135/buildTransitive/Uno.UI.Tasks/Uno.UI.Tasks.da217df2312e9e39676880f9cb4b8d519cc297e0.dll</_AfterhoursUnoTasksAssembly>
    <_AfterhoursWasmTasksAssembly>$(NuGetPackageRoot)/microsoft.net.sdk.webassembly.pack/10.0.11/tools/net10.0/Microsoft.NET.Sdk.WebAssembly.Pack.Tasks.dll</_AfterhoursWasmTasksAssembly>
    <_AfterhoursMonoTasks>$(NetCoreRoot)/packs/Microsoft.NET.Runtime.MonoTargets.Sdk/10.0.11/tasks/net10.0/MonoTargetsTasks.dll</_AfterhoursMonoTasks>
    <_AfterhoursAppTasks>$(NetCoreRoot)/packs/Microsoft.NET.Runtime.WebAssembly.Sdk/10.0.11/tasks/net10.0/WasmAppBuilder.dll</_AfterhoursAppTasks>
  </PropertyGroup>
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Uno.UI.Tasks.LinkerHintsGenerator.LinkerDefinitionMergerTask_da217df2312e9e39676880f9cb4b8d519cc297e0" AssemblyFile="$(_AfterhoursUnoTasksAssembly)" Override="true" />
