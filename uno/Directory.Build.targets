  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Uno.UI.Tasks.LinkerHintsGenerator.LinkerDescriptorGeneratorTask_da217df2312e9e39676880f9cb4b8d519cc297e0" AssemblyFile="$(_AfterhoursUnoTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Uno.UI.Tasks.EmbeddedResourceInjector.EmbeddedResourceInjectorTask_da217df2312e9e39676880f9cb4b8d519cc297e0" AssemblyFile="$(_AfterhoursUnoTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.NET.Sdk.WebAssembly.ComputeWasmBuildAssets" AssemblyFile="$(_AfterhoursWasmTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.NET.Sdk.WebAssembly.ComputeWasmPublishAssets" AssemblyFile="$(_AfterhoursWasmTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.NET.Sdk.WebAssembly.GenerateWasmBootJson" AssemblyFile="$(_AfterhoursWasmTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.NET.Sdk.WebAssembly.ConvertDllsToWebCil" AssemblyFile="$(_AfterhoursWasmTasksAssembly)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="ComputeManagedAssemblies" AssemblyFile="$(NuGetPackageRoot)/microsoft.net.illink.tasks/10.0.11/tools/net/ILLink.Tasks.dll" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="ILLink" AssemblyFile="$(NuGetPackageRoot)/microsoft.net.illink.tasks/10.0.11/tools/net/ILLink.Tasks.dll" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="MonoTargetsTasks.MarshalingPInvokeScanner" AssemblyFile="$(_AfterhoursMonoTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="EmitBundleObjectFiles" AssemblyFile="$(_AfterhoursMonoTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.WebAssembly.Build.Tasks.WasmLoadAssembliesAndReferences" AssemblyFile="$(_AfterhoursAppTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.WebAssembly.Build.Tasks.ManagedToNativeGenerator" AssemblyFile="$(_AfterhoursAppTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.WebAssembly.Build.Tasks.EmccCompile" AssemblyFile="$(_AfterhoursAppTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.WebAssembly.Build.Tasks.WasmCalculateInitialHeapSize" AssemblyFile="$(_AfterhoursAppTasks)" Override="true" />
  <UsingTask Condition="'$(AfterhoursUseInProcessUnoTasks)' == 'true'" TaskName="Microsoft.WebAssembly.Build.Tasks.WasmAppBuilder" AssemblyFile="$(_AfterhoursAppTasks)" Override="true" />
</Project>
